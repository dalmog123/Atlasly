{
  "name": "atlasly",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An interactive travel discovery globe — explore the world one country at a time.",
  "license": "MIT",
  "scripts": {
    "prepare:data": "node scripts/prepare-data.mjs",
    "check:data": "node scripts/check-data.mjs",
    "dev": "npm run prepare:data && vite",
    "build": "npm run prepare:data && npm run check:data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-globe.gl": "^2.38.0",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.4",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0"
  }
}
